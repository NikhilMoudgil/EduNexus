generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------
// 1. USER & AUTH MODELS
// ------------------------------------------------------

enum UserRole {
  STUDENT
  MENTOR
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          UserRole  @default(STUDENT)
  
  accounts      Account[]
  sessions      Session[]
  
  // Relations
  roadmaps      CombinedPlan[] 
  applications  PlacementApplication[] 
  posts         Post[]
  comments      Comment[]
  likes         Like[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ------------------------------------------------------
// 2. COMMUNITY (STUDY STORIES) MODELS
// ------------------------------------------------------

model Post {
  id           String    @id @default(cuid())
  content      String    @db.Text
  
  // 🖼️ NEW: Media Support for Supabase Storage
  mediaUrl     String?   @db.Text
  mediaType    String?   // Expected: 'image' or 'video'

  // 🔗 NEW: Added missing fields from your server action
  externalLink String?   @db.Text
  pollData     Json?

  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  isVerified   Boolean   @default(false)
  expiresAt    DateTime? // Null = Permanent (Mentor), Date = 24h (Student)
  
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  
  comments     Comment[]
  likes        Like[]
}

model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  postId    String
  userId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Like {
  id     String @id @default(cuid())
  postId String
  userId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

// ------------------------------------------------------
// // ------------------------------------------------------
// 3. TRACKER & ROADMAP MODELS
// ------------------------------------------------------

model CombinedPlan {
  id        String   @id @default(cuid())
  title     String
  plan      String   @db.Text 
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 🚀 NEW: Types of opportunities Unstop/modern platforms track
enum OpportunityType {
  JOB
  INTERNSHIP
  HACKATHON
  CASE_COMPETITION
  OPEN_SOURCE
}

// 🚀 UPDATED: Expanded status pipeline
enum ApplicationStatus {
  BOOKMARKED
  SENT             // Kept 'SENT' so your existing DB records don't break
  ASSESSMENT_PENDING
  INTERVIEWING
  OFFERED
  REJECTED
  GHOSTED
}

model PlacementApplication {
  id            String            @id @default(cuid())
  company       String
  role          String
  type          OpportunityType   @default(JOB)
  status        ApplicationStatus @default(SENT)
  salary        Int?
  notes         String?           @db.Text
  
  // 🚀 NEW: Advanced Tracking Fields
  link          String?           // URL to the posting/hackathon
  deadline      DateTime?         // Important for case comps/hackathons
  resumeLink    String?           // Which resume version was used
  coverLetterId String?           // Which cover letter was used
  tags          String[]          // e.g., ["React", "PostgreSQL", "Next.js"]

  dateApplied   DateTime          @default(now())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  // 🚀 NEW: Relational data for multi-stage interviews
  rounds        InterviewRound[]
}

// 🚀 NEW: Track individual interview stages (OA, Technical, HR)
model InterviewRound {
  id            String               @id @default(cuid())
  applicationId String
  application   PlacementApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  
  title         String               // e.g., "Online Assessment (OA)", "System Design"
  date          DateTime?
  status        String               // e.g., "UPCOMING", "CLEARED", "FAILED"
  feedback      String?              @db.Text
  
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}